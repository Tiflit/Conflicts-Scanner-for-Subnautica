<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ConflictScanner.ViewModels"
        xmlns:cs="clr-namespace:ConflictScanner"
        x:Class="ConflictScanner.Views.MainWindow"
        Width="980" Height="680"
        Title="Subnautica Conflict Scanner"
        mc:Ignorable="d">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
    <!-- Path + controls -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Game path:" VerticalAlignment="Center"/>
      <TextBox Width="450"
               Text="{Binding GamePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="Browse..."
              Click="OnBrowseClick"
              IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanNegationConverter}}"/>
      <Button Content="Detect"
              Command="{Binding DetectGameCommand}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanNegationConverter}}"/>
      <CheckBox Content="Deep scan"
                IsChecked="{Binding DeepScan}"
                VerticalAlignment="Center"
                IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanNegationConverter}}"/>
      <Button Content="Scan"
              Command="{Binding RunScanCommand}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanNegationConverter}}"/>
    </StackPanel>

    <!-- Status -->
    <TextBlock Grid.Row="1"
               Margin="0,8,0,4"
               Text="{Binding Status}"/>

    <!-- Report Area -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <Grid>
        <TabControl Margin="4">
          <!-- Structured Findings Tab -->
          <TabItem Header="Findings">
            <Grid RowDefinitions="Auto,*">
              <!-- Filter Toolbar -->
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                <TextBox Width="240"
                         Watermark="Search findings, mod names..."
                         Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Category:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <ComboBox Width="120"
                          ItemsSource="{Binding AvailableCategories}"
                          SelectedItem="{Binding SelectedCategory}"/>
                <TextBlock Text="Min Impact:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <ComboBox Width="130"
                          ItemsSource="{Binding AvailableImpacts}"
                          SelectedItem="{Binding SelectedMinImpact}"/>
                <Button Content="Reset"
                        Command="{Binding ResetFiltersCommand}"/>
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.75"
                           Margin="8,0,0,0"
                           Text="{Binding FilteredFindings.Count, StringFormat='Showing {0} finding(s)'}"/>
              </StackPanel>

              <!-- Findings List -->
              <ListBox Grid.Row="1" ItemsSource="{Binding FilteredFindings}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="cs:Finding">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,2,0,4">
                      <StackPanel Spacing="4">
                        <!-- Badge Row -->
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                          <Border Grid.Column="0"
                                  Background="{Binding Impact, Converter={StaticResource ImpactColorConverter}}"
                                  CornerRadius="3"
                                  Padding="5,2"
                                  Margin="0,0,6,0">
                            <TextBlock Text="{Binding Impact}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                          </Border>
                          <Border Grid.Column="1"
                                  Background="{DynamicResource SystemControlBackgroundBaseMediumBrush}"
                                  CornerRadius="3"
                                  Padding="5,2"
                                  Margin="0,0,6,0">
                            <TextBlock Text="{Binding Confidence}"
                                       FontSize="11"
                                       Opacity="0.85"/>
                          </Border>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Category}"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"/>

                          <Button Grid.Column="4"
                                  Content="Open Folder"
                                  FontSize="11"
                                  Padding="6,2"
                                  VerticalAlignment="Center"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenModFolderCommand}"
                                  CommandParameter="{Binding}"/>
                        </Grid>

                        <!-- Description -->
                        <SelectableTextBlock Text="{Binding Explanation}"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap"/>

                        <!-- Evidence / Action -->
                        <SelectableTextBlock Text="{Binding Evidence}"
                                             Opacity="0.75"
                                             FontSize="12"
                                             TextWrapping="Wrap"/>

                        <SelectableTextBlock Text="{Binding SuggestedAction, StringFormat='Recommendation: {0}'}"
                                             IsVisible="{Binding SuggestedAction, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             FontStyle="Italic"
                                             Opacity="0.85"
                                             FontSize="12"
                                             TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <!-- Installed Mods Tab -->
          <TabItem Header="Installed Mods">
            <Grid RowDefinitions="Auto,*">
              <!-- Filter Toolbar -->
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                <TextBox Width="260"
                         Watermark="Search mods, assemblies, GUIDs..."
                         Text="{Binding ModFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Status:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <ComboBox Width="130"
                          ItemsSource="{Binding AvailableModStatusFilters}"
                          SelectedItem="{Binding SelectedModStatusFilter}"/>
                <Button Content="Reset"
                        Command="{Binding ResetModFiltersCommand}"/>
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.75"
                           Margin="8,0,0,0"
                           Text="{Binding FilteredInstalledMods.Count, StringFormat='Showing {0} mod(s)'}"/>
              </StackPanel>

              <!-- Mods List -->
              <ListBox Grid.Row="1" ItemsSource="{Binding FilteredInstalledMods}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="cs:InstalledModInfo">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,2,0,4">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <!-- Status Badge -->
                        <Border Grid.Column="0" Grid.Row="0"
                                Background="{Binding Status, Converter={StaticResource ModStatusColorConverter}}"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Status}"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                        </Border>

                        <!-- Loader Badge -->
                        <Border Grid.Column="1" Grid.Row="0"
                                Background="{DynamicResource SystemControlBackgroundBaseMediumBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Loader}"
                                     FontSize="11"
                                     Opacity="0.85"/>
                        </Border>

                        <!-- Mod Name & Version -->
                        <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="Bold"
                                     FontSize="14"/>
                          <TextBlock Text="{Binding Version, StringFormat='(v{0})'}"
                                     IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Opacity="0.75"
                                     FontSize="12"
                                     VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Open Folder Button -->
                        <Button Grid.Column="3" Grid.Row="0"
                                Content="Open Folder"
                                FontSize="11"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstalledModFolderCommand}"
                                CommandParameter="{Binding}"/>

                        <!-- Detail Row (GUID & Path & Issues) -->
                        <StackPanel Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                          <TextBlock Text="{Binding GuidOrId, StringFormat='ID: {0}'}"
                                     IsVisible="{Binding GuidOrId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Opacity="0.7"
                                     FontSize="11"/>
                          <TextBlock Text="{Binding RelativePath, StringFormat='Location: {0}'}"
                                     Opacity="0.7"
                                     FontSize="11"/>
                          <TextBlock Text="{Binding FindingsCount, StringFormat='{0} issue(s) reported'}"
                                     IsVisible="{Binding HasIssues}"
                                     FontWeight="SemiBold"
                                     Foreground="#C62828"
                                     FontSize="11"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <!-- Raw Report Text Tab -->
          <TabItem Header="Raw Report">
            <TextBox Text="{Binding ReportText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     Background="Transparent"
                     BorderThickness="0"/>
          </TabItem>
        </TabControl>

        <!-- Scanning overlay with Cancel option -->
        <Border Background="{DynamicResource ScanOverlayBrush}"
                IsVisible="{Binding IsBusy}">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="12">
            <TextBlock Text="{Binding ProgressMessage}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <Button Content="Cancel Scan"
                    HorizontalAlignment="Center"
                    Command="{Binding CancelScanCommand}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Footer -->
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,8,0,0">
      <Button Content="Save report..."
              Click="OnSaveReportClick"
              IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanNegationConverter}}"/>
      <TextBlock Opacity="0.6"
                 VerticalAlignment="Center"
                 Text="ConflictScanner — v0.2.0"/>
    </StackPanel>
  </Grid>
</Window>
